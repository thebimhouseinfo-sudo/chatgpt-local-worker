PORT=3000

# Bind chi localhost (mac dinh). Dat 0.0.0.0 de mo ra LAN — KHONG khuyen khich.
HOST=127.0.0.1

# Token tuy chon trong URL path: endpoint thanh /<token> va /mcp/<token>.
# Neu de trong, MCP route khong co path token; chi expose ra ngoai qua tunnel/co che tin cay.
# Tao token: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_TOKEN=

# Thu muc PROJECT ma Local Worker se coi la workspace mac dinh.
# Day phai la repo/project dang lam viec, KHONG phai thu muc cai dat chatgpt-local-worker.
# Project memory co the doc CLAUDE.md / AGENTS.md tu workspace nay vao MCP instructions.
WORKSPACE_PATH=C:\Users\YourName\projects\my-app

# Them project khac (phan cach bang ; tren Windows)
# EXTRA_WORKSPACE_PATHS=D:\Coding\other-repo

# slim = bo core tool khuyen dung cho ChatGPT web (mac dinh).
# full = expose tat ca local tools. So luong tool co the thay doi theo phien ban.
CHATGPT_TOOL_PROFILE=slim

# Post-edit hooks (php -l, node --check sau khi sua file)
# POST_EDIT_HOOKS_CONFIG=profiles/post-edit-hooks.json

# Shell cwd luu giua cac tool call ChatGPT
# MCP_SHELL_STATE_DIR=.mcp-state

# Gioi han project memory inject vao MCP instructions (mac dinh ~25KB)
# PROJECT_MEMORY_MAX_BYTES=25000
# PROJECT_MEMORY_MAX_LINES=200

# User memory (tu dong load neu ton tai):
#   %USERPROFILE%\.codex\CLAUDE.md  hoac  %USERPROFILE%\.claude\CLAUDE.md

# Giam popup xac nhan tool tren ChatGPT; quyen cua platform van la authority cuoi cung.
CHATGPT_AUTO_APPROVE=true

SHELL_TIMEOUT=120
AUDIT_LOG_PATH=.mcp-audit.log

# Checkpoint / rewind (Claude Code-style code undo)
CHECKPOINT_ENABLED=true
CHECKPOINT_PATH=.mcp-checkpoints
CHECKPOINT_MAX_COUNT=500
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_MAX_FILE_BYTES=5242880

# Admin GUI (localhost-only)
ADMIN_PORT=3001
ADMIN_TOKEN=

# Upstream MCP hub config
MCP_UPSTREAM_CONFIG=profiles/mcp-upstream.json

# MCP session stability (tranh loi reconnect / stale session)
MCP_SESSION_RECOVERY=true
MCP_SESSION_DELETE_GRACE_MS=45000

# OpenAI Secure MCP Tunnel
# Lay tunnel ID / runtime key tu OpenAI Platform; openai-tunnel.ps1 se tao profile local.
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_API_KEY=
