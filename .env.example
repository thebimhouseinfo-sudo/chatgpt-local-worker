PORT=3000

# Bind localhost only. Keep this as 127.0.0.1 for normal GPTWorker use.
HOST=127.0.0.1

# Optional token in the local MCP URL path.
# Leave empty when using the OpenAI Secure MCP Tunnel on this trusted local machine.
MCP_TOKEN=

# slim = recommended ChatGPT tool set; full = expose all local tools.
CHATGPT_TOOL_PROFILE=slim

# Trusted single-user local workflow: reduce repeated ChatGPT permission prompts.
# ChatGPT/platform permission settings remain authoritative.
CHATGPT_AUTO_APPROVE=true

# Post-edit hooks
# POST_EDIT_HOOKS_CONFIG=profiles/post-edit-hooks.json

# Shell timeout in seconds
SHELL_TIMEOUT=120
AUDIT_LOG_PATH=.mcp-audit.log

# Checkpoint / rewind
CHECKPOINT_ENABLED=true
CHECKPOINT_PATH=.mcp-checkpoints
CHECKPOINT_MAX_COUNT=500
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_MAX_FILE_BYTES=5242880

# Internal localhost admin service. It is not part of the normal GPTWorker UX.
ADMIN_PORT=3001
ADMIN_TOKEN=

# Optional upstream MCP hub config
MCP_UPSTREAM_CONFIG=profiles/mcp-upstream.json

# MCP session recovery
MCP_SESSION_RECOVERY=true
MCP_SESSION_DELETE_GRACE_MS=45000

# OpenAI Secure MCP Tunnel - configured once by setup.bat
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_API_KEY=

# Current job/workspace are NOT configured here.
# setup.bat creates root worker-state.json and GPTWorker updates it after confirmation.
