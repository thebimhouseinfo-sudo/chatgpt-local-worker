{
  "name": "chatgpt-local-worker",
  "version": "1.1.0",
  "description": "Stability-first ChatGPT-controlled local worker for Windows with Job Packs, reliable local execution, and OpenAI Secure MCP Tunnel transport",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebimhouseinfo-sudo/chatgpt-local-worker.git"
  },
  "homepage": "https://github.com/thebimhouseinfo-sudo/chatgpt-local-worker#readme",
  "bugs": {
    "url": "https://github.com/thebimhouseinfo-sudo/chatgpt-local-worker/issues"
  },
